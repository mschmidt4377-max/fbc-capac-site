{
  "name": "fbc-capac-site",
  "private": true,
  "description": "Lint tooling for the First Baptist Church of Capac static site",
  "scripts": {
    "lint:html": "html-validate \"site/**/*.html\"",
    "lint:css": "stylelint \"site/assets/css/**/*.css\"",
    "lint:js": "eslint site/assets/js tools/*.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^10.17.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "type": "module"
}
