{
  "root": true,
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": ["error", { "style": "any" }],
    "no-implicit-button-type": "warn",
    "no-inline-style": "warn",
    "prefer-native-element": "warn",
    "form-dup-name": ["error", { "shared": ["radio", "checkbox", "button", "reset", "submit"] }]
  }
}
